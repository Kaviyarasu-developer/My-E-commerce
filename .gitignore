# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Build output
target/

# Eclipse
.classpath
.project
.settings/
.metadata/
bin/

# Other IDEs
.idea/
*.iml
.vscode/

# Secrets and local configuration
.env
*.env
application-local.properties
application-local.yml

# OS files
.DS_Store
Thumbs.db

# Keep the Maven wrapper (the *.jar rule above would otherwise hide it)
!.mvn/wrapper/maven-wrapper.jar
